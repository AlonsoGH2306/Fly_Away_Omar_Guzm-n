                  "    pm.expect(list, 'La respuesta debería ser una lista (o {content: []} si es paginada)').to.be.an('array');",
                  "    const found = list.some(f => f.flightNumber === pm.collectionVariables.get('flightNumberValid') || f.id === pm.collectionVariables.get('flightIdValid'));",
