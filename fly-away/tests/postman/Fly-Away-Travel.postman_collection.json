              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = pm.collectionVariables.get('uniqueSuffix');",
                  "pm.collectionVariables.set('userEmail', `lab07.${suffix}@utec.edu.pe`);",
                  "pm.collectionVariables.set('userPassword', 'Password123');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Setup] Registro exitoso responde 200/201', function () {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test('[Setup] Guardamos el id del usuario para pruebas posteriores', function () {",
                  "    const body = pm.response.json();",
