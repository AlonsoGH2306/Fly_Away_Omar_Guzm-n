# Copia este archivo a `.env` y ajusta los valores según tu entorno.
# docker compose levanta PostgreSQL usando estas variables.

POSTGRES_DB=flyaway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# La app lee estas variables (si no las defines, usa los defaults del application.properties):
DB_URL=jdbc:postgresql://localhost:5433/flyaway
DB_USERNAME=postgres
DB_PASSWORD=postgres
SERVER_PORT=8080
JWT_SECRET=mi_secreto_super_seguro_para_fly_away_travel_2026
JWT_EXPIRATION=3600000